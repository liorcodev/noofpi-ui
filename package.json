{
  "name": "noofpi-ui",
  "version": "1.7.0",
  "description": "Tailwind-based Vue components for noofpi, themable with Color Theme Studio",
  "license": "MIT",
  "author": "Lior Cohen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liorcodev/noofpi-ui.git"
  },
  "homepage": "https://liorcodev.github.io/noofpi-ui-docs/",
  "bugs": {
    "url": "https://github.com/liorcodev/noofpi-ui/issues"
  },
  "keywords": [
    "noofpi",
    "vue",
    "tailwind",
    "components",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "style": "./src/css/index.css",
      "default": "./src/index.ts"
    },
    "./css": "./src/css/index.css",
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./components/*": "./src/components/*"
  },
  "files": [
    "src"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "bun --cwd playground run dev",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.158",
    "@iconify/tailwind4": "^1.2.3",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0",
    "vite": ">=7",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  }
}
